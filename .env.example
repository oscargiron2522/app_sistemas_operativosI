APP_NAME=LinuxCore
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Guatemala
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BCRYPT_ROUNDS=12

# Contrasenas de las cuentas de demostracion (si se dejan vacias, el seeder genera una aleatoria y la muestra en consola)
ADMIN_PASSWORD=
OBSERVADOR_PASSWORD=

# Directorios que el explorador de archivos (solo lectura) puede mostrar, separados por coma
SYSMON_RUTAS=/var/log,/etc,/home,/tmp,/var/www,/opt
